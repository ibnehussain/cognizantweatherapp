# ─── Weather Dashboard — Environment Variables ───────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.

# Flask
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# OpenWeatherMap — get a free key at https://openweathermap.org/api
OWM_API_KEY=your_openweathermap_api_key_here
OWM_TIMEOUT=8

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000
